    },
    {
      "datasource": {"type": "prometheus", "uid": "atep-prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 24},
      "id": 9,
      "targets": [
        {"expr": "atep_test_run_websocket_connections", "legendFormat": "connections", "refId": "A"}

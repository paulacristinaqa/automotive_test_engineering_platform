{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "atep-prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [
        {"expr": "sum by (route) (rate(atep_http_requests_total[5m]))", "legendFormat": "{{route}}", "refId": "A"}
      ],
      "title": "Request rate by route",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "atep-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le, route) (rate(atep_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}", "refId": "A"}
      ],
      "title": "HTTP latency p95",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "atep-prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "targets": [
        {"expr": "sum(rate(atep_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(atep_http_requests_total[5m])), 0.000001)", "legendFormat": "5xx ratio", "refId": "A"}
      ],
      "title": "HTTP 5xx ratio",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "atep-prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "targets": [
        {"expr": "sum by (method) (atep_http_requests_in_progress)", "legendFormat": "{{method}}", "refId": "A"}
      ],
      "title": "Requests in progress",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "atep-prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "id": 5,
      "targets": [
        {"expr": "atep:sli_http_success_ratio:rate5m", "legendFormat": "HTTP success ratio", "refId": "A"}
      ],
      "title": "API availability SLI (target 99.9%)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "atep-prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "id": 6,
      "targets": [
        {"expr": "atep_registered_modules", "legendFormat": "{{status}}", "refId": "A"}
      ],
      "title": "Monitored module health",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "atep-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 24},
      "id": 7,
      "targets": [
        {"expr": "atep_outbox_oldest_unpublished_age_seconds", "legendFormat": "oldest event", "refId": "A"}
      ],
      "title": "Outbox backlog age",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "atep-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},

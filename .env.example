ATEP_ENVIRONMENT=development
ATEP_DATABASE_URL=postgresql+asyncpg://atep:atep@postgres:5432/atep
ATEP_REDIS_URL=redis://redis:6379/0
ATEP_RABBITMQ_URL=amqp://atep:atep@rabbitmq:5672/
ATEP_JWT_SECRET=replace-with-at-least-32-random-characters
ATEP_ACCESS_TOKEN_MINUTES=30
ATEP_REFRESH_TOKEN_DAYS=30
ATEP_RATE_LIMIT_ENABLED=true
ATEP_AUTH_RATE_LIMIT_REQUESTS=5
ATEP_AUTH_RATE_LIMIT_IP_REQUESTS=20
ATEP_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
ATEP_API_RATE_LIMIT_REQUESTS=300
ATEP_API_RATE_LIMIT_WINDOW_SECONDS=60
ATEP_MODULE_RECONCILIATION_ENABLED=true
ATEP_MODULE_RECONCILIATION_INTERVAL_SECONDS=15
ATEP_TEST_SCHEDULER_ENABLED=true
ATEP_TEST_SCHEDULER_INTERVAL_SECONDS=5
ATEP_TEST_SCHEDULER_BATCH_SIZE=20
# Optional, used once to create the first administrator:
ATEP_BOOTSTRAP_ADMIN_EMAIL=admin@atep.example.com
ATEP_BOOTSTRAP_ADMIN_PASSWORD=
